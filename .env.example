# Genesys Cloud OAuth client (client credentials grant). Keep the real values out of git.
GENESYS_CLIENT_ID=
GENESYS_CLIENT_SECRET=
# Region domain, e.g. mypurecloud.com (US East), usw2.pure.cloud, mypurecloud.ie
GENESYS_REGION=mypurecloud.com
# Optional display name for this org in the org picker (otherwise read from Genesys)
GENESYS_ORG_LABEL=

# More orgs for the org picker: copy this block with 1, 2, 3, ... Each needs its own OAuth client.
# GENESYS_ORG_1_LABEL=Customer A
# GENESYS_ORG_1_CLIENT_ID=
# GENESYS_ORG_1_CLIENT_SECRET=
# GENESYS_ORG_1_REGION=usw2.pure.cloud

# Optional
PORT=3000
HOST=127.0.0.1
# Protect the dashboard with HTTP basic auth
DASHBOARD_USER=
DASHBOARD_PASSWORD=
CACHE_TTL_SECONDS=120
MAX_RANGE_DAYS=92
MAX_DETAIL_CONVERSATIONS=5000
MAX_TURN_PAGES_PER_BOT=40
EXCLUDE_BOT_TYPES=VOICESURVEY
MASK_SENSITIVE=true
