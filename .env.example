# Genesys Cloud orgs. Keep the real values out of git.
# List the orgs to show in the org picker, then add a block per name (uppercase, spaces become _).
GENESYS_ORGS=SC12,Acme

GENESYS_SC12_CLIENT_ID=
GENESYS_SC12_CLIENT_SECRET=
GENESYS_SC12_REGION=mypurecloud.com

GENESYS_ACME_CLIENT_ID=
GENESYS_ACME_CLIENT_SECRET=
GENESYS_ACME_REGION=usw2.pure.cloud
# Optional longer name for the picker
# GENESYS_ACME_LABEL=Acme Health

# Single-org alternative: leave GENESYS_ORGS unset and use
# GENESYS_CLIENT_ID=  GENESYS_CLIENT_SECRET=  GENESYS_REGION=mypurecloud.com

# Sharing (version 4): each viewer signs in with Genesys Cloud. See docs/sharing-and-hosting.md.
# SIGN_IN=genesys
# GENESYS_SC12_SIGNIN_CLIENT_ID=      # Code Authorization (PKCE) client; no secret needed
# GENESYS_SC12_SIGNIN_GRANT=pkce      # or implicit
# GENESYS_SC12_ORG_ID=                # only accept sign-ins to this org
# HTTPS directly, or TRUST_PROXY=true behind a proxy that ends TLS
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TRUST_PROXY=false
# FRAME_ANCESTORS='self' https://*.mypurecloud.com https://*.pure.cloud https://*.us-gov-pure.cloud

# Daily turn-data archive (uses the CLIENT_ID/CLIENT_SECRET pair above)
# ARCHIVE=on
# ARCHIVE_DIR=data/turns
# ARCHIVE_LIVE_DAYS=7
# ARCHIVE_KEEP_DAYS=400

# Optional
PORT=3000
HOST=127.0.0.1
# Protect the dashboard with HTTP basic auth
DASHBOARD_USER=
DASHBOARD_PASSWORD=
CACHE_TTL_SECONDS=120
MAX_RANGE_DAYS=92
MAX_DETAIL_CONVERSATIONS=5000
MAX_TURN_PAGES_PER_BOT=40
EXCLUDE_BOT_TYPES=VOICESURVEY
MASK_SENSITIVE=true

# Escalations tab: why sessions went to a person. Setting a key sends masked bot
# transcripts of escalated sessions to Anthropic's API for analysis.
# ANTHROPIC_API_KEY=

# Or Claude through Amazon Bedrock in your own AWS account (e.g. GovCloud). No Anthropic key needed.
# LLM_PROVIDER=bedrock
# AWS_REGION=us-gov-west-1
# AWS_PROFILE=
# AVA_MODEL=claude-opus-5-5
# BEDROCK_API=mantle
# BEDROCK_BASE_URL=
# Mark a non-us-gov org as government so it never goes to Anthropic's API:
# GENESYS_ACME_GOVERNMENT=true
# Let a government TEST org use Anthropic's API anyway (shows a warning; test data only):
# GENESYS_SC12FEDRAMPDEV_ALLOW_ANTHROPIC=true
