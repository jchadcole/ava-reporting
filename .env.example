# Genesys Cloud orgs. Keep the real values out of git.
# List the orgs to show in the org picker, then add a block per name (uppercase, spaces become _).
GENESYS_ORGS=SC12,Acme

GENESYS_SC12_CLIENT_ID=
GENESYS_SC12_CLIENT_SECRET=
GENESYS_SC12_REGION=mypurecloud.com

GENESYS_ACME_CLIENT_ID=
GENESYS_ACME_CLIENT_SECRET=
GENESYS_ACME_REGION=usw2.pure.cloud
# Optional longer name for the picker
# GENESYS_ACME_LABEL=Acme Health

# Single-org alternative: leave GENESYS_ORGS unset and use
# GENESYS_CLIENT_ID=  GENESYS_CLIENT_SECRET=  GENESYS_REGION=mypurecloud.com

# Optional
PORT=3000
HOST=127.0.0.1
# Protect the dashboard with HTTP basic auth
DASHBOARD_USER=
DASHBOARD_PASSWORD=
CACHE_TTL_SECONDS=120
MAX_RANGE_DAYS=92
MAX_DETAIL_CONVERSATIONS=5000
MAX_TURN_PAGES_PER_BOT=40
EXCLUDE_BOT_TYPES=VOICESURVEY
MASK_SENSITIVE=true
